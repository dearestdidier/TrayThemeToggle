// 这个文件是 UTF-8 保存的，必须显式告诉 windres 按 UTF-8 解析，
// 否则中文会按系统 ANSI 代码页解释，版本信息里就会出现乱码。
#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

IDI_SUN  ICON "res/sun.ico"
IDI_MOON ICON "res/moon.ico"
IDI_APP  ICON "res/app.ico"

// 让程序以「当前用户权限」运行，不弹 UAC；同时声明 Per-Monitor V2 DPI 感知
1 24 "res/app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "TrayThemeToggle"
            VALUE "FileDescription",  "任务栏托盘深浅色主题切换器"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TrayThemeToggle.exe"
            VALUE "OriginalFilename", "TrayThemeToggle.exe"
            VALUE "ProductName",      "主题切换器"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
